# ==============================================================================
# LOMONEGROTV - VARIABLES DE ENTORNO (.env.example)
# ==============================================================================

# URL base de la aplicación (usada para redirecciones y webhooks de Mercado Pago)
# En desarrollo: http://localhost:3000
# En producción (Vercel): https://tu-dominio.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# SUPABASE (Base de datos PostgreSQL y Autenticación)
# Obtenidas de: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# URL del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (usada de forma segura en cliente y servidor)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave de Service Role (NUNCA exponer en cliente, solo en servidor para Webhooks y bypass de RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# MERCADO PAGO (Checkout Pro y Pagos)
# Obtenidas de: Mercado Pago Developers -> Tus aplicaciones -> Credenciales de producción/prueba
# ------------------------------------------------------------------------------
# Access Token (Bearer Token de Mercado Pago)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# CLOUDFLARE STREAM (Live Streaming con Signed URLs RSA-256)
# Obtenidas de: Cloudflare Dashboard -> Stream -> Signing Keys
# ------------------------------------------------------------------------------
# ID de la Signing Key generada en Cloudflare Stream
CLOUDFLARE_STREAM_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clave privada RSA en formato PEM PKCS#8.
# Si está en una sola línea, conserva los saltos de línea literales \n
CLOUDFLARE_STREAM_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA0...\n-----END RSA PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# ADMINISTRACIÓN Y SEGURIDAD (Panel de Operaciones /admin)
# ------------------------------------------------------------------------------
# Hash PBKDF2 SHA-512 de la contraseña de administrador (opcional, tiene fallback seguro por defecto)
# Formato: salt:hash_hex
ADMIN_PASSWORD_HASH="4bc0855c1f70beae78f4534f6079cf1e:3a2bf245388fe21865a38132fca518b35357fd73b9a99b4219a64bb4a02cf3665f9624e4dc456253b2cc6c7a53814b234dff02760ae2d091226b7ddd78470969"

